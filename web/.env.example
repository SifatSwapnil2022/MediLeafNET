# Copy to .env.local for local testing (npm run dev reads it), and add the same
# values in Vercel -> Project -> Settings -> Environment Variables.

# Required for full answers. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: semantic (vector) search. Without these, keyword search is used.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# MIN_SCORE=0.72
